+def _stamp_booking_validity(info, now):
+    """Mark when a share code was verified and when it must be treated as stale (snapshot freshness, not kickoff)."""
+    info=dict(info or {})
+    info["validated_at"]=now.isoformat()
+    info["valid_until"]=(now+timedelta(minutes=BOOKING_VALID_MINUTES)).isoformat()
+    info["clean"]=bool(info.get("status")=="AVAILABLE" and not info.get("unavailable_outcomes"))
+    return info
+
+
+def _validate_batch_bookings(batches, now, create=None):
+    """Ask SportyBet for a share code for the first few batches in the same run as the snapshot.
+
+    A batch is `clean` only if SportyBet accepted every selection (no unavailableOutcomes).
+    Nothing is dropped or rewritten: legs, odds and gates are untouched. Returns the index of
+    the first clean batch, or None.
+    """
+    create=create or _create_sportybet_booking_code
+    first_clean=None
+    for idx,batch in enumerate((batches or [])[:BOOKING_REVALIDATION_BATCHES]):
+        legs=list(batch.get("legs") or [])
+        info=_stamp_booking_validity(create(legs) if legs else {"status":"UNAVAILABLE","reason":"empty_batch"}, now)
+        batch["sportybet_booking"]=info
+        batch["booking_validated"]=info["clean"]
+        if info["clean"] and first_clean is None:
+            first_clean=idx
+    return first_clean
+
