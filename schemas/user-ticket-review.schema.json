{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://match-signal.pages.dev/schemas/user-ticket-review.schema.json",
  "title": "Match Signal private user ticket review",
  "description": "Private evidence input only. Do not commit populated records to the public repository or publish them as static assets. Each user-played leg is recorded separately from the overall accumulator outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "mode",
    "updated_at",
    "tickets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "private_user_ticket_review"
    },
    "mode": {
      "const": "PRIVATE_USER_EVIDENCE"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tickets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/ticket"
      }
    }
  },
  "$defs": {
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_ref",
        "captured_at",
        "reported_ticket_outcome",
        "legs"
      ],
      "properties": {
        "ticket_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Internal non-identifying reference only; never use a sportsbook ticket ID or verification code."
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "reported_ticket_outcome": {
          "enum": [
            "PENDING",
            "WON",
            "LOST",
            "VOID"
          ]
        },
        "stake": {
          "type": "number",
          "minimum": 0
        },
        "total_odds": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "total_return": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "default": "NGN",
          "maxLength": 8
        },
        "legs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/leg"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "market",
        "pick"
      ],
      "properties": {
        "market": {
          "enum": [
            "total_goals_over_under",
            "total_games_over_under",
            "match_winner",
            "basketball_total_points",
            "other"
          ]
        },
        "pick": {
          "enum": [
            "over",
            "under",
            "p1",
            "p2",
            "draw",
            "other"
          ]
        },
        "line": {
          "type": "number",
          "minimum": 0
        },
        "odds": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "model_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "market": {
                "enum": [
                  "total_goals_over_under",
                  "total_games_over_under",
                  "basketball_total_points"
                ]
              }
            },
            "required": [
              "market"
            ]
          },
          "then": {
            "required": [
              "line"
            ],
            "properties": {
              "pick": {
                "enum": [
                  "over",
                  "under"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "market": {
                "const": "match_winner"
              }
            },
            "required": [
              "market"
            ]
          },
          "then": {
            "properties": {
              "pick": {
                "enum": [
                  "p1",
                  "p2",
                  "draw"
                ]
              }
            }
          }
        }
      ]
    },
    "desk_snapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/selection"
        },
        {
          "type": "object",
          "required": [
            "captured_at",
            "provenance"
          ],
          "properties": {
            "prediction_id": {
              "type": "string",
              "maxLength": 160
            },
            "model_version": {
              "type": "string",
              "maxLength": 100
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            },
            "provenance": {
              "const": "user_reported"
            }
          }
        }
      ]
    },
    "scoreSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "away"
      ],
      "properties": {
        "home": {
          "type": "number",
          "minimum": 0
        },
        "away": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "number",
          "minimum": 0
        },
        "away": {
          "type": "number",
          "minimum": 0
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/scoreSet"
          }
        },
        "winner": {
          "enum": [
            "p1",
            "p2",
            "draw"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "home",
            "away"
          ]
        },
        {
          "required": [
            "sets"
          ]
        },
        {
          "required": [
            "winner"
          ]
        }
      ]
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg_ref",
        "product",
        "match",
        "actual_selection"
      ],
      "properties": {
        "leg_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "competition": {
          "type": "string",
          "maxLength": 120
        },
        "match": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "event_id": {
          "type": "string",
          "maxLength": 160
        },
        "kickoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "desk_snapshot": {
          "$ref": "#/$defs/desk_snapshot"
        },
        "actual_selection": {
          "$ref": "#/$defs/selection"
        },
        "final_score": {
          "$ref": "#/$defs/score"
        },
        "settled_at": {
          "type": "string",
          "format": "date-time"
        },
        "leg_outcome": {
          "enum": [
            "PENDING",
            "WON",
            "LOST",
            "PUSH",
            "VOID"
          ]
        },
        "leg_outcome_source": {
          "enum": [
            "user_reported",
            "official_score",
            "system_calculated"
          ]
        },
        "leg_outcome_captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "qualification_state": {
          "enum": [
            "QUALIFIED",
            "NOT_QUALIFIED",
            "UNKNOWN"
          ]
        },
        "qualification_captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
